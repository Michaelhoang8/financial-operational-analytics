Actual obligations = SUM(FactMonthly[Actual])
Planned obligations = SUM(FactMonthly[Plan])
Plan minus actual = [Planned obligations] - [Actual obligations]
Variance % = DIVIDE([Plan minus actual], ABS([Planned obligations]))
Reported months = DISTINCTCOUNT(FactMonthly[Period])
Agency count = DISTINCTCOUNT(FactMonthly[AgencyKey])
YTD actual at latest month = VAR LastPeriod = MAX(DimPeriod[Period]) RETURN CALCULATE(SUM(FactYTD[Actual]), DimPeriod[Period] = LastPeriod)
YTD plan at latest month = VAR LastPeriod = MAX(DimPeriod[Period]) RETURN CALCULATE(SUM(FactYTD[Plan]), DimPeriod[Period] = LastPeriod)
YTD plan minus actual = [YTD plan at latest month] - [YTD actual at latest month]
YTD variance % = DIVIDE([YTD plan minus actual], ABS([YTD plan at latest month]))
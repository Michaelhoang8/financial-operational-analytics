        "measures": [
          {
            "name": "Actual Amount",
            "expression": "DIVIDE(SUM(FactActual[AmountCents]), 100)",
            "formatString": "\"$\"#,0;(\"$\"#,0);\"$\"0",
            "lineageTag": "24ef6a29-24f5-5fd2-b658-e62a68ae9af2",
            "displayFolder": "Financial"
          },
          {
            "name": "Budget Amount",
            "expression": "DIVIDE(SUM(FactBudget[AmountCents]), 100)",
            "formatString": "\"$\"#,0;(\"$\"#,0);\"$\"0",
            "lineageTag": "8881920e-6945-532c-8af1-db5c134e033b",
            "displayFolder": "Financial"
          },
          {
            "name": "Revenue",
            "expression": "CALCULATE([Actual Amount], DimAccount[Category] = \"Revenue\")",
            "formatString": "\"$\"#,0;(\"$\"#,0);\"$\"0",
            "lineageTag": "0d9c0f9d-ad80-56c1-a9b7-39fa8fa71c65",
            "displayFolder": "Financial"
          },
          {
            "name": "COGS",
            "expression": "CALCULATE([Actual Amount], DimAccount[Category] = \"COGS\")",
            "formatString": "\"$\"#,0;(\"$\"#,0);\"$\"0",
            "lineageTag": "b1ec32cb-96be-5399-b255-b1c438832302",
            "displayFolder": "Financial"
          },
          {
            "name": "Operating Costs",
            "expression": "CALCULATE([Actual Amount], DimAccount[Category] = \"Opex\")",
            "formatString": "\"$\"#,0;(\"$\"#,0);\"$\"0",
            "lineageTag": "b988959e-0f03-5699-be2b-0f85a75612ac",
            "displayFolder": "Financial"
          },
          {
            "name": "Gross Profit",
            "expression": "[Revenue] - [COGS]",
            "formatString": "\"$\"#,0;(\"$\"#,0);\"$\"0",
            "lineageTag": "18b5e4c2-c7bc-5d32-9287-aad713877568",
            "displayFolder": "Financial"
          },
          {
            "name": "Gross Margin %",
            "expression": "DIVIDE([Gross Profit], [Revenue])",
            "formatString": "0.0%",
            "lineageTag": "2fd8c3d0-9f2b-562e-a291-79c389ad6fc7",
            "displayFolder": "Financial"
          },
          {
            "name": "Operating Profit",
            "expression": "[Gross Profit] - [Operating Costs]",
            "formatString": "\"$\"#,0;(\"$\"#,0);\"$\"0",
            "lineageTag": "0eccd3dc-1f6e-5035-9851-080ac2be0b91",
            "displayFolder": "Financial"
          },
          {
            "name": "Budget Revenue",
            "expression": "CALCULATE([Budget Amount], DimAccount[Category] = \"Revenue\")",
            "formatString": "\"$\"#,0;(\"$\"#,0);\"$\"0",
            "lineageTag": "a6667ae6-01c0-53bf-a1b4-ea80dca6e363",
            "displayFolder": "Financial"
          },
          {
            "name": "Budget Profit",
            "expression": "[Budget Revenue] - CALCULATE([Budget Amount], DimAccount[Category] IN {\"COGS\", \"Opex\"})",
            "formatString": "\"$\"#,0;(\"$\"#,0);\"$\"0",
            "lineageTag": "a6f687f9-68a2-54f0-a165-b243f2a03d4c",
            "displayFolder": "Financial"
          },
          {
            "name": "Revenue Variance",
            "expression": "[Revenue] - [Budget Revenue]",
            "formatString": "\"$\"#,0;(\"$\"#,0);\"$\"0",
            "lineageTag": "8e084939-7eef-5818-bcd5-23215b843149",
            "displayFolder": "Financial"
          },
          {
            "name": "Revenue Variance %",
            "expression": "DIVIDE([Revenue Variance], [Budget Revenue])",
            "formatString": "0.0%",
            "lineageTag": "0dac566d-ec28-541a-9635-ef38069bfe7e",
            "displayFolder": "Financial"
          },
          {
            "name": "Profit Variance",
            "expression": "[Operating Profit] - [Budget Profit]",
            "formatString": "\"$\"#,0;(\"$\"#,0);\"$\"0",
            "lineageTag": "3d11b931-6580-5f54-8812-ca9a6a098c3d",
            "displayFolder": "Financial"
          },
          {
            "name": "Favorable Account Variance",
            "expression": "SUMX(VALUES(DimAccount[AccountKey]), IF(CALCULATE(SELECTEDVALUE(DimAccount[Category])) = \"Revenue\", [Actual Amount] - [Budget Amount], [Budget Amount] - [Actual Amount]))",
            "formatString": "\"$\"#,0;(\"$\"#,0);\"$\"0",
            "lineageTag": "7dc737bf-886f-53bc-8760-7d515577d317",
            "displayFolder": "Financial"
          },
          {
            "name": "Revenue YTD",
            "expression": "TOTALYTD([Revenue], DimDate[Date])",
            "formatString": "\"$\"#,0;(\"$\"#,0);\"$\"0",
            "lineageTag": "b72875a3-b2f1-5fdf-a9b3-a1ab30b623b6",
            "displayFolder": "Financial"
          },
          {
            "name": "Revenue Previous Year",
            "expression": "CALCULATE([Revenue], SAMEPERIODLASTYEAR(DimDate[Date]))",
            "formatString": "\"$\"#,0;(\"$\"#,0);\"$\"0",
            "lineageTag": "ae62a01a-aba8-53dc-8506-011b75ccaf29",
            "displayFolder": "Financial"
          },
          {
            "name": "Revenue YoY %",
            "expression": "DIVIDE([Revenue] - [Revenue Previous Year], [Revenue Previous Year])",
            "formatString": "0.0%",
            "lineageTag": "fac479f5-170a-5017-b00a-54290d5fd83a",
            "displayFolder": "Financial"
          },
          {
            "name": "Orders",
            "expression": "COUNTROWS(FactOrders)",
            "formatString": "#,0",
            "lineageTag": "526e8582-a573-5c17-9fa3-20d54413c0ae",
            "displayFolder": "Operations"
          },
          {
            "name": "On-Time Orders",
            "expression": "SUM(FactOrders[OnTime])",
            "formatString": "#,0",
            "lineageTag": "9f41ac8c-656a-5f2b-a4e0-419a10ac9e3b",
            "displayFolder": "Operations"
          },
          {
            "name": "On-Time Delivery %",
            "expression": "DIVIDE([On-Time Orders], [Orders])",
            "formatString": "0.0%",
            "lineageTag": "7b4039c6-d612-59da-81c4-cd8e09420b89",
            "displayFolder": "Operations"
          },
          {
            "name": "Closing Inventory",
            "expression": "VAR LastSnapshot = MAX(FactInventory[Date]) RETURN IF(NOT ISBLANK(LastSnapshot), CALCULATE(DIVIDE(SUM(FactInventory[ValueCents]), 100), KEEPFILTERS(DimDate[Date] = LastSnapshot)))",
            "formatString": "\"$\"#,0;(\"$\"#,0);\"$\"0",
            "lineageTag": "12ba206b-58b1-5c4b-8bce-1b1a7f8de25c",
            "displayFolder": "Operations"
          },
          {
            "name": "Closing Units",
            "expression": "VAR LastSnapshot = MAX(FactInventory[Date]) RETURN IF(NOT ISBLANK(LastSnapshot), CALCULATE(SUM(FactInventory[Units]), KEEPFILTERS(DimDate[Date] = LastSnapshot)))",
            "formatString": "#,0",
            "lineageTag": "cf246955-d010-5731-9580-a04b2b7ad2c6",
            "displayFolder": "Operations"
          },
          {
            "name": "Freight",
            "expression": "CALCULATE([Actual Amount], DimAccount[AccountKey] = 6200)",
            "formatString": "\"$\"#,0;(\"$\"#,0);\"$\"0",
            "lineageTag": "06b4dafd-4183-5906-9888-2444174b05db"
          },
          {
            "name": "Budget Freight",
            "expression": "CALCULATE([Budget Amount], DimAccount[AccountKey] = 6200)",
            "formatString": "\"$\"#,0;(\"$\"#,0);\"$\"0",
            "lineageTag": "7147131c-648a-55d4-96de-b65328cf682b"
          },
          {
            "name": "Operating Margin %",
            "expression": "DIVIDE([Operating Profit], [Revenue])",
            "formatString": "0.0%",
            "lineageTag": "fb0cc932-f8d4-5fb6-9c5b-5c58002a64b0"
          },
          {
            "name": "Late Orders",
            "expression": "[Orders] - [On-Time Orders]",
            "formatString": "#,0",
            "lineageTag": "9efcb41c-0c95-5d23-9953-5f857a9b5130"
          },
          {
            "name": "Budget Operating Costs",
            "expression": "CALCULATE([Budget Amount], DimAccount[Category] = \"Opex\")",
            "formatString": "\"$\"#,0;(\"$\"#,0);\"$\"0",
            "lineageTag": "8eb362a4-36f4-50cf-9816-a3a09e76c5db"
          },
          {
            "name": "Operating Cost Variance",
            "expression": "[Budget Operating Costs] - [Operating Costs]",
            "formatString": "\"$\"#,0;(\"$\"#,0);\"$\"0",
            "lineageTag": "ffc1f071-f631-5840-a071-7f5b617da905"
          }
        ]
      },

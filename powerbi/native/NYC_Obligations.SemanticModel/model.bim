        "partitions": [
          {
            "name": "FactMonthly",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                " Source = Csv.Document(Binary.FromText(\"\", BinaryEncoding.Base64), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                " Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                " Typed = Table.TransformColumnTypes(Headers, {{\"Period\", type text}, {\"AgencyKey\", Int64.Type}, {\"Actual\", type number}, {\"Plan\", type number}, {\"Publication\", type text}}, \"en-US\")",
                "in",
                " Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Actual obligations",
            "expression": "SUM(FactMonthly[Actual])",
            "formatString": "#,0;(#,0);0",
            "lineageTag": "3b3e5087-c4f0-5d27-916c-d2c847358fac",
            "description": "USD millions"
          },
          {
            "name": "Planned obligations",
            "expression": "SUM(FactMonthly[Plan])",
            "formatString": "#,0;(#,0);0",
            "lineageTag": "df514cdd-a11b-51a6-b302-9ade0b4b21b1",
            "description": "USD millions"
          },
          {
            "name": "Plan minus actual",
            "expression": "[Planned obligations] - [Actual obligations]",
            "formatString": "#,0;(#,0);0",
            "lineageTag": "ea13fb3c-bdeb-5c9a-abdd-001238f98c5b",
            "description": "USD millions"
          },
          {
            "name": "Variance %",
            "expression": "DIVIDE([Plan minus actual], ABS([Planned obligations]))",
            "formatString": "0.0%",
            "lineageTag": "7c1849e0-db43-5e3f-bd7b-fed58b89b345",
            "description": "Count or ratio"
          },
          {
            "name": "Reported months",
            "expression": "DISTINCTCOUNT(FactMonthly[Period])",
            "formatString": "#,0;(#,0);0",
            "lineageTag": "4dd07737-31cd-5799-8106-a9b7acd612c0",
            "description": "Count or ratio"
          },
          {
            "name": "Agency count",
            "expression": "DISTINCTCOUNT(FactMonthly[AgencyKey])",
            "formatString": "#,0;(#,0);0",
            "lineageTag": "6c364ae7-f181-58ff-9ebf-47c60ba28c76",
            "description": "Count or ratio"
          },
          {
            "name": "YTD actual at latest month",
            "expression": "VAR LastPeriod = MAX(DimPeriod[Period]) RETURN CALCULATE(SUM(FactYTD[Actual]), DimPeriod[Period] = LastPeriod)",
            "formatString": "#,0;(#,0);0",
            "lineageTag": "75cb5367-1a65-53df-a7ba-2d7462a304d5",
            "description": "USD millions"
          },
          {
            "name": "YTD plan at latest month",
            "expression": "VAR LastPeriod = MAX(DimPeriod[Period]) RETURN CALCULATE(SUM(FactYTD[Plan]), DimPeriod[Period] = LastPeriod)",
            "formatString": "#,0;(#,0);0",
            "lineageTag": "22ddaeb7-2b1d-5134-8d09-b308aa74ce91",
            "description": "USD millions"
          },
          {
            "name": "YTD plan minus actual",
            "expression": "[YTD plan at latest month] - [YTD actual at latest month]",
            "formatString": "#,0;(#,0);0",
            "lineageTag": "ad5397be-79a4-525b-ac38-efd68c80f167",
            "description": "USD millions"
          },
          {
            "name": "YTD variance %",
            "expression": "DIVIDE([YTD plan minus actual], ABS([YTD plan at latest month]))",
            "formatString": "0.0%",
            "lineageTag": "52ec7e6e-65aa-5210-b1c0-16b11a560030",
            "description": "Count or ratio"
          }
        ]
